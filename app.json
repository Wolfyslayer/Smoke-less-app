{
  "expo": {
    "name": "Smoke Less",
    "slug": "smoke-less",
    "scheme": "smokeless",
    "version": "6.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101a15",
          "dark": {
            "backgroundColor": "#0D1B13"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Smoke Less"
    },
    "experiments": {
      "baseUrl": "/Smoke-less-app"
    },
    "android": {
      "package": "com.smokeless.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/branding/adaptive-icon-background.png"
      },
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "icon": "./assets/branding/icon.png"
  }
}

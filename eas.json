{
  "cli": {"version": ">= 27.3.0", "appVersionSource": "remote"},
  "build": {
    "development": {"developmentClient": true, "distribution": "internal", "environment": "development", "env": {"APP_VARIANT": "development"}},
    "preview": {"developmentClient": false, "distribution": "internal", "channel": "preview", "environment": "preview", "autoIncrement": true, "android": {"buildType": "apk"}, "env": {"APP_VARIANT": "preview"}},
    "production": {"developmentClient": false, "distribution": "store", "channel": "production", "environment": "production", "autoIncrement": true, "android": {"buildType": "app-bundle"}, "env": {"APP_VARIANT": "production"}}
  }
}

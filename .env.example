# Public build configuration only. Never put passwords or private keys here.
# CI can derive the Google Web client ID from its existing Firebase config.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Keep off until isolated client/server/native deletion acceptance is approved.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
EXPO_PUBLIC_ACCOUNT_DELETION_REGION=europe-west1

# Select development (default), preview or production before Expo/EAS commands.
# APP_VARIANT=preview
# Preview Firebase file is gitignored; EAS uses GOOGLE_SERVICES_JSON_PREVIEW.
